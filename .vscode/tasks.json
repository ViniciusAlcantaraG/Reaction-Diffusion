{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-O3",
                "-ffast-math",
                "-march=native",
                "-flto",
                "-Wall",
                "-std=c++17",
                "main.cpp",
                "-o",
                "morphogenesis.exe",
                "-IC:/msys64/ucrt64/include",
                "-LC:/msys64/ucrt64/lib",
                "-lraylib",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "MSYS2 UCRT64 g++ + raylib"
        }
    ]
}
